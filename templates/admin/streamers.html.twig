{% extends 'admin/layout.html.twig' %}

{% block admin_title %}配信者{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div><p class="eyebrow">MANAGEMENT</p><h1>配信者</h1><p>配信者とプラットフォームアカウントを管理します。</p></div>
        <form action="{{ path('admin_streamer_register') }}" method="post" class="toolbar-actions">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_register') }}">
            <input name="name" required maxlength="191" placeholder="配信者名">
            <input name="agency_id" required maxlength="36" placeholder="所属区分ID">
            <select name="platform"><option value="youtube">YouTube</option><option value="twitch">Twitch</option><option value="twitcasting">TwitCasting</option></select>
            <input name="registration_identifier" required maxlength="255" placeholder="チャンネルID・ハンドル等">
            <input name="color_code" maxlength="7" pattern="#[0-9A-Fa-f]{6}" placeholder="#RRGGBB">
            <button class="button button-primary" type="submit">配信者を追加</button>
        </form>
    </section>

    <section class="panel table-panel">
        <div class="table-toolbar"><span class="muted">登録済みの配信者とアカウントを表示しています</span></div>
        <div class="table-scroll">
            <table class="data-table" id="streamer-table">
                <thead><tr><th>配信者</th><th>所属区分</th><th>プラットフォーム</th><th>状態</th><th>最終同期</th><th><span class="sr-only">操作</span></th></tr></thead>
                <tbody>
                    {% for streamer in streamers %}
                        <tr>
                            <td><div class="person-cell"><span class="avatar"{% if streamer.color_code %} style="background: {{ streamer.color_code }}"{% endif %}>{{ streamer.name|slice(0, 2) }}</span><div><strong>{{ streamer.name }}</strong><small>{{ streamer.accounts|length }} アカウント</small></div></div></td>
                            <td>{{ streamer.agency_name }}</td>
                            <td><div class="platform-stack">{% for account in streamer.accounts %}<span class="platform-logo {{ account.platform.value }}">{{ account.platform.displayId }}</span>{% endfor %}</div></td>
                            <td><span class="state-badge {{ streamer.is_enabled ? 'state-active' : 'state-paused' }}"><i></i>{{ streamer.is_enabled ? '有効' : '停止中' }}</span></td>
                            <td><span class="muted">DB登録済み</span></td>
                            <td></td>
                        </tr>
                    {% else %}
                        <tr class="empty-table-row"><td colspan="6"><strong>配信者はまだ登録されていません</strong><span>配信者登録機能の実装後、この一覧へ表示されます。</span></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <footer class="table-footer"><span>{{ streamers|length }}件</span><small>データベースから取得しています</small></footer>
    </section>
{% endblock %}
