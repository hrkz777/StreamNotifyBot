{% extends 'admin/layout.html.twig' %}

{% block admin_title %}配信者{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div><p class="eyebrow">MANAGEMENT</p><h1>配信者</h1><p>配信者とプラットフォームアカウントを管理します。</p></div>
        <button class="button button-primary" type="button" data-dialog-open="streamer-dialog"{% if agencies is empty %} disabled{% endif %}>＋ 配信者を追加</button>
    </section>

    {% if agencies is empty %}
        <div class="preview-banner" role="status"><strong>所属区分が必要です</strong><span><a href="{{ path('admin_agencies') }}">所属区分を登録</a>してから配信者を追加してください。</span></div>
    {% endif %}

    <section class="panel table-panel">
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>配信者</th><th>所属区分</th><th>表示色</th><th>状態</th></tr></thead>
                <tbody>
                    {% for streamer in streamers %}
                        {% set agency = agencies[streamer.agencyId] ?? null %}
                        <tr>
                            <td><strong>{{ streamer.nameFor(streamer.defaultLanguage).name }}</strong></td>
                            <td>{{ agency ? agency.nameFor(agency.defaultLanguage).displayName : '所属区分（未接続）' }}</td>
                            <td>{% if streamer.colorCode %}<span class="color-swatch" style="background: {{ streamer.colorCode }}"></span><code>{{ streamer.colorCode }}</code>{% else %}未設定{% endif %}</td>
                            <td>{{ streamer.isEnabled ? '有効' : '停止中' }}</td>
                        </tr>
                    {% else %}
                        <tr class="empty-table-row"><td colspan="4"><strong>配信者はまだ登録されていません</strong><span>「配信者を追加」からプラットフォームアカウントを確認して登録できます。</span></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <footer class="table-footer"><span>{{ streamers|length }}件</span><small>登録内容はデータベースに保存されます</small></footer>
    </section>

    <dialog class="app-dialog" id="streamer-dialog">
        <form method="post" action="{{ path('admin_streamers') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_registration') }}">
            <header><div><p class="eyebrow">NEW STREAMER</p><h2>配信者を追加</h2></div><button type="button" class="dialog-close" data-dialog-close aria-label="閉じる">×</button></header>
            <div class="dialog-body">
                <div class="form-grid form-grid-2">
                    <label><span>配信者名（日本語）</span><input name="name_ja" required maxlength="191" autocomplete="off" placeholder="配信者名を入力"></label>
                    <label><span>配信者名（英語）</span><input name="name_en" maxlength="191" autocomplete="off" placeholder="任意"></label>
                </div>
                <div class="form-grid form-grid-2">
                    <label><span>所属区分</span><select name="agency_id" required>{% for agency in agencies %}<option value="{{ agency.id }}">{{ agency.nameFor(agency.defaultLanguage).displayName }}</option>{% endfor %}</select></label>
                    <label><span>表示色</span><span class="color-input"><input name="color" value="#7C5CFF" maxlength="7" pattern="#[0-9A-Fa-f]{6}" aria-label="カラーコード"></span></label>
                </div>
                <hr>
                <h3>プラットフォームアカウント</h3>
                <div class="form-grid account-input-row">
                    <label><span>プラットフォーム</span><select name="platform" required><option value="youtube">YouTube</option><option value="twitch">Twitch</option><option value="twitcasting">TwitCasting</option></select></label>
                    <label><span>チャンネルID・ハンドル・URL</span><input name="registration_identifier" required maxlength="255" autocomplete="off" placeholder="登録用識別子を入力"></label>
                </div>
                <p class="form-help">登録時にプラットフォームAPIでアカウントを確認します。</p>
            </div>
            <footer><button class="button button-secondary" type="button" data-dialog-close>キャンセル</button><button class="button button-primary" type="submit">確認して登録する</button></footer>
        </form>
    </dialog>
{% endblock %}
