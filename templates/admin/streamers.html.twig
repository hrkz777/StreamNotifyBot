{% extends 'admin/layout.html.twig' %}

{% block admin_title %}配信者{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div><p class="eyebrow">MANAGEMENT</p><h1>配信者</h1><p>配信者とプラットフォームアカウントを管理します。</p></div>
        <div class="toolbar-actions"><a class="button button-secondary" href="{{ path('admin_streamers_csv') }}">CSVで確認</a><button class="button button-primary" type="button" data-dialog-open="streamer-dialog"{% if agencies is empty %} disabled{% endif %}>＋ 配信者を追加</button></div>
    </section>

    {% if agencies is empty %}
        <div class="preview-banner" role="status"><strong>所属区分が必要です</strong><span><a href="{{ path('admin_agencies') }}">所属区分を登録</a>してから配信者を追加してください。</span></div>
    {% endif %}

    <section class="panel table-panel">
        <div class="table-scroll">
            <table class="data-table streamer-table">
                <colgroup><col class="streamer-table-name"><col class="streamer-table-agency"><col class="streamer-table-accounts"><col class="streamer-table-color"><col class="streamer-table-status"><col class="streamer-table-actions"></colgroup>
                <thead><tr><th>配信者</th><th>所属区分</th><th>アカウント</th><th>表示色</th><th>状態</th><th>操作</th></tr></thead>
                <tbody>
                    {% for streamer in streamers %}
                        {% set agency = agencies[streamer.agencyId] ?? null %}
                        <tr>
                            <td><strong>{{ streamer.nameFor(streamer.defaultLanguage).name }}</strong></td>
                            <td>{{ agency ? agency.nameFor(agency.defaultLanguage).displayName : '所属区分（未接続）' }}</td>
                            <td><ul class="inline-list">{% for account in platform_accounts|filter(account => account.streamerId == streamer.id) %}<li>{{ account.platform.displayId }}{% if account.displayId %}: {{ account.displayId }}{% endif %}</li>{% else %}<li>未接続</li>{% endfor %}</ul></td>
                            <td>{% if streamer.colorCode %}<span class="color-preview"><span class="color-swatch" style="background: {{ streamer.colorCode }}" aria-hidden="true"></span><code>{{ streamer.colorCode }}</code></span>{% else %}未設定{% endif %}</td>
                            <td>{{ streamer.isEnabled ? '有効' : '停止中' }}</td>
                            <td><div class="row-actions"><button class="button button-secondary" type="button" data-dialog-open="streamer-edit-dialog" data-streamer-edit="{{ streamer.id }}" data-streamer-name-ja="{{ streamer.nameFor(streamer.defaultLanguage).name }}" data-streamer-name-en="{{ streamer_english_names[streamer.id] ?? '' }}" data-streamer-agency-id="{{ streamer.agencyId }}" data-streamer-color="{{ streamer.colorCode ?? '' }}" data-streamer-enabled="{{ streamer.isEnabled ? '1' : '0' }}">編集</button></div></td>
                        </tr>
                    {% else %}
                        <tr class="empty-table-row"><td colspan="6"><strong>配信者はまだ登録されていません</strong><span>「配信者を追加」からプラットフォームアカウントを確認して登録できます。</span></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <footer class="table-footer"><span>{{ streamers|length }}件</span><small>登録内容はデータベースに保存されます</small></footer>
    </section>

    <dialog class="app-dialog" id="streamer-dialog">
        <form method="post" action="{{ path('admin_streamers') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_registration') }}">
            <header><div><p class="eyebrow">NEW STREAMER</p><h2>配信者を追加</h2></div><button type="button" class="dialog-close" data-dialog-close aria-label="閉じる">×</button></header>
            <div class="dialog-body">
                <div class="form-grid form-grid-2">
                    <label><span>配信者名（日本語）</span><input name="name_ja" required maxlength="191" autocomplete="off" placeholder="配信者名を入力"></label>
                    <label><span>配信者名（英語）</span><input name="name_en" maxlength="191" autocomplete="off" placeholder="任意"></label>
                </div>
                <div class="form-grid form-grid-2">
                    <label><span>所属区分</span><select name="agency_id" required>{% for agency in agencies %}<option value="{{ agency.id }}">{{ agency.nameFor(agency.defaultLanguage).displayName }}</option>{% endfor %}</select></label>
                    <label><span>表示色</span><span class="color-input"><input type="color" value="#7C5CFF" data-streamer-color-picker aria-label="表示色を選択"><input name="color" value="#7C5CFF" maxlength="7" pattern="#[0-9A-Fa-f]{6}" data-streamer-color aria-label="カラーコード"></span></label>
                </div>
                <hr>
                <h3>プラットフォームアカウント</h3>
                <div class="form-grid account-input-row">
                    <label><span>プラットフォーム</span><select name="platform" required><option value="youtube">YouTube</option><option value="twitch">Twitch</option><option value="twitcasting">TwitCasting</option></select></label>
                    <label><span>チャンネルID・ハンドル・URL</span><input name="registration_identifier" required maxlength="255" autocomplete="off" placeholder="登録用識別子を入力"></label>
                </div>
                <p class="form-help">登録時にプラットフォームAPIでアカウントを確認します。</p>
            </div>
            <footer><button class="button button-secondary" type="button" data-dialog-close>キャンセル</button><button class="button button-primary" type="submit">確認して登録する</button></footer>
        </form>
    </dialog>

    <dialog class="app-dialog" id="streamer-edit-dialog">
        <form id="streamer-edit-form" method="post" action="{{ path('admin_streamers') }}" data-streamer-edit-form>
            <input type="hidden" name="action" value="update">
            <input type="hidden" name="streamer_id" data-streamer-edit-id>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_update') }}">
            <header><div><p class="eyebrow">配信者の編集</p><h2>配信者情報を編集</h2></div><button type="button" class="dialog-close" data-dialog-close aria-label="閉じる">×</button></header>
            <div class="dialog-body">
                <div class="form-grid form-grid-2">
                    <label><span>配信者名（日本語）</span><input name="name_ja" required maxlength="191" autocomplete="off" data-streamer-edit-name-ja></label>
                    <label><span>配信者名（英語）</span><input name="name_en" maxlength="191" autocomplete="off" data-streamer-edit-name-en></label>
                </div>
                <div class="form-grid form-grid-2">
                    <label><span>所属区分</span><select name="agency_id" required data-streamer-edit-agency>{% for agency in agencies %}<option value="{{ agency.id }}">{{ agency.nameFor(agency.defaultLanguage).displayName }}</option>{% endfor %}</select></label>
                    <label><span>表示色</span><span class="color-input"><input type="color" value="#7C5CFF" data-streamer-edit-color-picker aria-label="表示色を選択"><input name="color" maxlength="7" pattern="#[0-9A-Fa-f]{6}" data-streamer-edit-color aria-label="カラーコード"></span></label>
                </div>
                <div class="streamer-edit-status"><div><strong>状態</strong><span>停止すると、この配信者の情報取得と通知対象から外れます。</span></div><label class="switch"><input name="is_enabled" type="checkbox" data-streamer-edit-enabled><span></span><em>有効にする</em></label></div>
            </div>
        </form>
        <section class="dialog-body streamer-account-management" aria-labelledby="streamer-edit-accounts-heading">
            <div class="dialog-section-heading"><div><h3 id="streamer-edit-accounts-heading">プラットフォームアカウント</h3><p>紐付け済みのアカウントを確認し、追加または削除できます。</p></div></div>
            <div data-streamer-edit-accounts></div>
            <form method="post" action="{{ path('admin_streamer_accounts_add') }}" class="form-grid account-input-row streamer-account-add-form">
                <input type="hidden" name="streamer_id" data-streamer-edit-account-streamer-id>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_account_add') }}">
                <label><span>プラットフォーム</span><select name="platform" required><option value="youtube">YouTube</option><option value="twitch">Twitch</option><option value="twitcasting">TwitCasting</option></select></label>
                <label><span>チャンネルID・ハンドル・URL</span><input name="registration_identifier" required maxlength="255" autocomplete="off" placeholder="登録用識別子を入力"></label>
                <div><button class="button button-secondary" type="submit">追加する</button></div>
            </form>
            <p class="form-help">追加時はプラットフォームAPIで確認します。配信履歴があるアカウントは、履歴保護のため削除できません。</p>
        </section>
        <footer><button class="button button-secondary" type="button" data-dialog-close>キャンセル</button><button class="button button-primary" type="submit" form="streamer-edit-form">基本情報を保存</button></footer>
    </dialog>

    {% for streamer in streamers %}
        <template data-streamer-accounts-template="{{ streamer.id }}">
            <ul class="streamer-account-list">
                {% for account in platform_accounts|filter(account => account.streamerId == streamer.id) %}
                    <li><div><strong>{{ account.platform.displayId }}</strong><span>{% if account.displayId %}{{ account.displayId }}{% elseif account.name %}{{ account.name }}{% else %}表示名未取得{% endif %}</span></div><form method="post" action="{{ path('admin_streamer_accounts_remove') }}" data-streamer-account-remove-form><input type="hidden" name="streamer_id" value="{{ streamer.id }}"><input type="hidden" name="platform_account_id" value="{{ account.id }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_account_remove') }}"><button class="button button-secondary button-danger" type="submit">削除</button></form></li>
                {% else %}
                    <li class="streamer-account-list-empty">アカウントはまだ登録されていません。</li>
                {% endfor %}
            </ul>
        </template>
    {% endfor %}
{% endblock %}
