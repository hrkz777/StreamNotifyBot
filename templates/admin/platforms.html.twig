{% extends 'admin/layout.html.twig' %}

{% block admin_title %}プラットフォーム{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div><p class="eyebrow">PLATFORM STATUS</p><h1>プラットフォーム</h1><p>外部サービスの設定状況と登録アカウント数を確認します。</p></div>
    </section>

    <div class="platform-card-grid" data-platform-root>
        {% for platform in [
            ['youtube', 'YouTube', 'WebSub + Data API v3', '▶'],
            ['twitch', 'Twitch', 'EventSub + Helix API', '◧'],
            ['twitcasting', 'TwitCasting', 'Webhook + API', '●']
        ] %}
            <article class="panel platform-card" data-platform-card="{{ platform[0] }}">
                <header><span class="platform-hero {{ platform[0] }}">{{ platform[3] }}</span><div><h2>{{ platform[1] }}</h2><p>{{ platform[2] }}</p></div>{% set state = platform_connection_states[platform[0]] %}<span class="connection-state {{ state.class }}" data-platform-state><i></i>{{ state.label }}</span></header>
                <dl class="platform-stats"><div><dt>登録アカウント</dt><dd>{{ platform_account_counts[platform[0]] ?? 0 }}</dd></div><div><dt>有効な購読</dt><dd>{{ platform_active_subscription_counts[platform[0]] ?? 0 }}</dd></div></dl>
                {% set credential_state = platform_credential_states[platform[0]] %}<p class="connection-state {{ credential_state.class }}" data-platform-credential-state><i></i>{{ credential_state.label }}</p>
                <div class="quota-block"><div><span>API使用量</span><strong>未計測</strong></div><small>外部APIの使用量計測は未接続です。</small></div>
                <footer><span>{% if platform_active_subscription_counts[platform[0]] ?? 0 %}データベースに有効な購読があります{% elseif platform_account_counts[platform[0]] ?? 0 %}登録アカウントの購読状態を確認してください{% else %}登録アカウントがありません{% endif %}</span></footer>
                <form method="post" action="{{ path('admin_platform_api_credential_update') }}" autocomplete="off" style="margin-top:1rem">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_api_credential_update') }}">
                    <input type="hidden" name="platform" value="{{ platform[0] }}">
                    {% if platform[0] == 'youtube' %}
                        <label>APIキー<input type="password" name="api_key" required maxlength="255" autocomplete="new-password"></label>
                        <label>WebSubシークレット<input type="password" name="websub_secret" required minlength="32" maxlength="199" autocomplete="new-password"></label>
                    {% else %}
                        <label>Client ID<input type="password" name="client_id" required maxlength="255" autocomplete="new-password"></label>
                        <label>Client Secret<input type="password" name="client_secret" required maxlength="255" autocomplete="new-password"></label>
                    {% endif %}
                    <button type="submit">接続情報を更新</button>
                </form>
                {% if platform[0] == 'twitch' %}
                    <form method="post" action="{{ path('admin_twitch_connection_test') }}" style="margin-top:.75rem">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('twitch_connection_test') }}">
                        <button type="submit">Twitch接続を確認</button>
                    </form>
                {% endif %}
            </article>
        {% endfor %}
    </div>

    <section class="panel" style="margin-top:1.25rem">
        <header class="panel-header"><div><h2>Webhook公開URL</h2><p>外部サービスがイベントを送信するHTTPS公開URLです。更新にはowner権限と再認証が必要です。</p></div></header>
        <form method="post" action="{{ path('admin_webhook_callback_url_update') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('webhook_callback_url_update') }}">
            <label>公開URL<input name="callback_url" type="url" value="{{ webhook_callback_url ?? '' }}" maxlength="2048" placeholder="https://notify.example" required></label>
            <button type="submit">Webhook公開URLを更新</button>
        </form>
    </section>

    <section class="panel subscription-panel">
        <header class="panel-header"><div><h2>購読と同期の状態</h2><p>保存済みの有効Webhook購読を表示します。</p></div></header>
        {% if active_subscriptions is empty %}
            <div class="empty-subscription-state"><strong>有効な購読はありません</strong><span>データベースに保存済みの有効なWebhook購読がある場合に表示します。</span></div>
        {% else %}
            <div style="overflow-x:auto;"><table><thead><tr><th>プラットフォーム</th><th>購読種別</th><th>次回更新予定</th></tr></thead><tbody>{% for subscription in active_subscriptions %}<tr data-active-subscription><td>{{ subscription.platform }}</td><td>{{ subscription.subscription_type }}</td><td>{{ subscription.renew_after ? subscription.renew_after|date('Y/m/d H:i') : '—' }}</td></tr>{% endfor %}</tbody></table></div>
        {% endif %}
    </section>

{% endblock %}
