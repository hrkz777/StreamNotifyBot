{% extends 'admin/layout.html.twig' %}

{% block admin_title %}プラットフォーム{% endblock %}

{% block admin_body %}
    <section class="page-heading">
        <div><p class="eyebrow">PLATFORM SETTINGS</p><h1>プラットフォーム</h1><p>配信者の登録と同期で使うAPI資格情報を管理します。</p></div>
    </section>

    <div class="platform-card-grid">
        {% for platform in [
            ['youtube', 'YouTube', 'WebSub + Data API v3', '▶', [['api_key', 'APIキー']]],
            ['twitch', 'Twitch', 'EventSub + Helix API', '◧', [['client_id', 'Client ID'], ['client_secret', 'Client Secret']]],
            ['twitcasting', 'TwitCasting', 'Webhook + API', '●', [['client_id', 'Client ID'], ['client_secret', 'Client Secret']]]
        ] %}
            <article class="panel platform-card">
                <header><span class="platform-hero {{ platform[0] }}">{{ platform[3] }}</span><div><h2>{{ platform[1] }}</h2><p>{{ platform[2] }}</p></div><span class="connection-state {{ configured_platforms[platform[0]] ? 'is-success' : 'is-warning' }}"><i></i>{{ configured_platforms[platform[0]] ? '登録済み' : '未設定' }}</span></header>
                <form method="post" action="{{ path('admin_platform_credential_save', {platform: platform[0]}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('platform_credential_' ~ platform[0]) }}">
                    <div class="form-grid">
                        {% for field in platform[4] %}
                            <label><span>{{ field[1] }}</span><input name="{{ field[0] }}" type="password" autocomplete="new-password" required aria-describedby="{{ platform[0] }}-credential-help"></label>
                        {% endfor %}
                    </div>
                    <p class="dialog-help" id="{{ platform[0] }}-credential-help">入力値は保存時に暗号化され、以後は画面・CSV・ログへ表示されません。更新時は新しい値をすべて入力してください。</p>
                    <footer><button class="button button-primary" type="submit">API資格情報を保存</button></footer>
                </form>
            </article>
        {% endfor %}
    </div>

    <section class="panel subscription-panel">
        <header class="panel-header"><div><h2>接続確認</h2><p>資格情報を保存後、配信者の追加またはCSV検証時に対応プラットフォームへの接続を確認します。</p></div></header>
        <div class="empty-subscription-state"><strong>API資格情報は安全に保管されます</strong><span>外部APIからのエラーは秘密値を含めず、実行した画面に表示します。</span></div>
    </section>
{% endblock %}
