{% extends 'admin/layout.html.twig' %}

{% block admin_title %}ダッシュボード{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div>
            <p class="eyebrow" data-dashboard-date>日付を読み込み中</p>
            <h1>ダッシュボード</h1>
            <p>登録済みの設定状況を確認できます。</p>
        </div>
        <button class="button button-secondary" type="button" data-dashboard-refresh>↻ 状態を更新</button>
    </section>

    <section class="metric-grid" aria-label="主要指標">
        <article class="metric-card metric-accent-purple">
            <div class="metric-icon">◉</div>
            <div><span>配信中</span><strong>{{ live_streams|length }}</strong><small>保存済みのライブ配信</small></div>
        </article>
        <article class="metric-card metric-accent-blue">
            <div class="metric-icon">◷</div>
            <div><span>今後の配信予定</span><strong>{{ upcoming_streams|length }}</strong><small>保存済みの予定配信</small></div>
        </article>
        <article class="metric-card metric-accent-green">
            <div class="metric-icon">✓</div>
            <div><span>直近24時間の通知</span><strong>{{ notification_activity|length }}</strong><small>送信済み通知</small></div>
        </article>
        <article class="metric-card metric-accent-orange">
            <div class="metric-icon">⌁</div>
            <div><span>登録配信者</span><strong>{{ streamer_count }}</strong><small>{{ platform_summary }}</small></div>
        </article>
    </section>

    <div class="dashboard-grid">
        <section class="panel live-panel">
            <header class="panel-header">
                <div><span class="live-pulse"></span><h2>現在配信中</h2></div>
                <a href="{{ path('admin_streamers') }}">配信者を確認 →</a>
            </header>
            {% for stream in live_streams %}
                <article class="live-stream-item" data-live-stream>
                    <span class="platform-logo {{ stream.platform }}">{{ stream.platform_display_id }}</span>
                    <div><strong>{{ stream.title }}</strong><small>{{ stream.streamer_name }}{% if stream.actual_start_at %}・{{ stream.actual_start_at|date('H:i') }} 開始{% endif %}</small></div>
                </article>
            {% else %}
                <div class="dashboard-empty-state"><strong>配信情報はまだありません</strong><span>データベースに保存済みのライブ配信がある場合に表示します。</span></div>
            {% endfor %}
        </section>

        <section class="panel schedule-panel">
            <header class="panel-header"><h2>今後の予定</h2><span class="muted">最大5件</span></header>
            {% for stream in upcoming_streams %}
                <article class="live-stream-item" data-upcoming-stream>
                    <span class="platform-logo {{ stream.platform }}">{{ stream.platform_display_id }}</span>
                    <div><strong>{{ stream.title }}</strong><small>{{ stream.streamer_name }}・{{ stream.scheduled_start_at|date('m/d H:i') }} 予定</small></div>
                </article>
            {% else %}
                <div class="dashboard-empty-state"><strong>配信予定はまだありません</strong><span>データベースに保存済みの今後の予定配信がある場合に表示します。</span></div>
            {% endfor %}
        </section>
    </div>

    <div class="dashboard-bottom-grid">
        <section class="panel activity-panel">
            <header class="panel-header"><h2>通知アクティビティ</h2><span class="muted">直近24時間</span></header>
            {% for notification in notification_activity %}
                <article class="live-stream-item" data-notification-activity>
                    <span class="event-icon">✓</span>
                    <div><strong>{{ notification.title }}</strong><small>{{ notification.type }}・{{ notification.sent_at|date('m/d H:i') }} 送信</small></div>
                </article>
            {% else %}
                <div class="dashboard-empty-state dashboard-empty-chart"><strong>通知履歴はまだありません</strong><span>データベースに保存済みの送信済み通知がある場合に表示します。</span></div>
            {% endfor %}
        </section>
        <section class="panel health-panel">
            <header class="panel-header"><h2>接続状態</h2><a href="{{ path('admin_platforms') }}">詳細 →</a></header>
            {% for platform in [['youtube', 'YouTube', 'WebSub + API', '▶'], ['twitch', 'Twitch', 'EventSub + API', '◧'], ['twitcasting', 'TwitCasting', 'Webhook + API', '●']] %}
                {% set active_count = platform_active_subscription_counts[platform[0]] ?? 0 %}
                <div class="health-row" data-dashboard-platform-status="{{ platform[0] }}"><span class="platform-logo {{ platform[0] }}">{{ platform[3] }}</span><div><strong>{{ platform[1] }}</strong><small>{{ platform[2] }}</small></div><span class="{{ active_count > 0 ? 'health-ok' : 'health-warn' }}">{{ active_count > 0 ? active_count ~ ' 件の有効な購読' : '未設定' }}</span></div>
            {% endfor %}
        </section>
    </div>
{% endblock %}
