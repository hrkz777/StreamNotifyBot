{% extends 'admin/layout.html.twig' %}

{% block admin_title %}配信者CSV{% endblock %}

{% block admin_body %}
    <section class="page-heading page-heading-actions">
        <div><p class="eyebrow">CSV IMPORT / EXPORT</p><h1>配信者CSV</h1><p>配信者とプラットフォームアカウントをCSVで確認・登録します。</p></div>
        <div class="toolbar-actions"><a class="button button-secondary" href="{{ path('admin_streamers') }}">配信者一覧へ戻る</a><a class="button button-secondary" href="{{ path('admin_streamers_csv_template') }}">登録用テンプレート</a><a class="button button-primary" href="{{ path('admin_streamers_csv_export') }}">CSVをエクスポート</a></div>
    </section>
    <section class="panel" style="padding:24px; margin-bottom:24px;"><form method="post" enctype="multipart/form-data" class="form-grid"><input type="hidden" name="action" value="preview"><input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_csv_preview') }}"><label><span>CSVファイル</span><input type="file" name="csv_file" accept=".csv,text/csv" required></label><p class="form-help">固定ヘッダー、UTF-8またはShift_JIS。1行は1アカウントで、同じstreamer_keyを1配信者として登録します。</p><p class="form-help">同姓同名を識別するため、登録済み配信者は下表の配信者ID、アカウントIDを確認してください。インポートCSVの永続IDによる更新対応は次段階で追加します。</p><p class="form-help">ヘッダー: schema_version, streamer_key, agency_code, default_language, name_ja, name_en, color_code, is_enabled, platform, registration_identifier, platform_account_enabled</p><div><button class="button button-primary" type="submit">プレビューする</button></div></form></section>
    {% if preview is not null %}<section class="panel" style="padding:24px; margin-bottom:24px;"><h2>{{ preview.registrations|length }}件を登録予定</h2><ul>{% for registration in preview.registrations %}<li>{{ registration.names[0].name }}（{{ registration.accounts|length }}アカウント）</li>{% endfor %}</ul><form method="post"><input type="hidden" name="action" value="execute"><input type="hidden" name="_csrf_token" value="{{ csrf_token('streamer_csv_execute') }}"><input type="hidden" name="preview_token" value="{{ preview.token }}"><button class="button button-primary" type="submit">この内容を登録する</button></form></section>{% endif %}
    <section class="panel table-panel"><div class="table-scroll"><table class="data-table"><thead><tr><th>配信者</th><th>配信者ID</th><th>プラットフォーム</th><th>アカウントID</th><th>外部ID</th><th>状態</th></tr></thead><tbody>
        {% for streamer in streamers %}{% for account in accounts_by_streamer[streamer.id] ?? [null] %}<tr><td><strong>{{ streamer.nameFor(streamer.defaultLanguage).name }}</strong></td><td><code>{{ streamer.id }}</code></td><td>{{ account ? account.platform.value : '未登録' }}</td><td>{% if account %}<code>{{ account.id }}</code>{% else %}—{% endif %}</td><td>{{ account ? account.externalId : '—' }}</td><td>{{ streamer.isEnabled and (account is null or account.isEnabled) ? '有効' : '停止中' }}</td></tr>{% endfor %}{% else %}<tr class="empty-table-row"><td colspan="6"><strong>配信者はまだ登録されていません</strong></td></tr>{% endfor %}
    </tbody></table></div><footer class="table-footer"><span>{{ streamers|length }}件</span><small>Excelで開けるShift_JIS形式です</small></footer></section>
{% endblock %}
