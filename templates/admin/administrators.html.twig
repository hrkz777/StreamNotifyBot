{% extends 'admin/layout.html.twig' %}

{% block admin_title %}管理者管理{% endblock %}

{% block admin_body %}
    <section class="panel">
        <div class="panel-header"><h1>管理者管理</h1></div>
        <div style="padding:24px;overflow-x:auto;">
            {% for message in app.flashes('success') %}<div role="status" class="preview-banner">{{ message }}</div>{% endfor %}
            {% for message in app.flashes('error') %}<div role="alert" class="preview-banner">{{ message }}</div>{% endfor %}
            <table>
                <thead><tr><th>表示名</th><th>ログインID</th><th>権限</th><th>状態</th><th>作成日時</th><th>操作</th></tr></thead>
                <tbody>
                    {% for administrator in administrators %}
                        <tr data-administrator-id="{{ administrator.id }}">
                            <td>{{ administrator.displayName }}</td>
                            <td>{{ administrator.loginId }}</td>
                            <td>{{ administrator.role.value }}</td>
                            <td>{{ administrator.status.value }}</td>
                            <td>{{ administrator.createdAt|date('Y-m-d H:i:s', 'UTC') }}</td>
                            <td>
                                {% if administrator.id != app.user.id and administrator.status.value == 'active' %}
                                    <form method="post" action="{{ path('admin_administrator_action', {administratorId: administrator.id, action: 'deactivate'}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('administrator_management_deactivate_' ~ administrator.id) }}">
                                        <button class="button button-secondary" type="submit">無効化</button>
                                    </form>
                                {% endif %}
                                {% if administrator.id != app.user.id and administrator.status.value != 'deleted' %}
                                    <form method="post" action="{{ path('admin_administrator_action', {administratorId: administrator.id, action: 'delete'}) }}" style="margin-top: 8px;">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('administrator_management_delete_' ~ administrator.id) }}">
                                        <button class="button button-danger" type="submit">削除</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">管理者はまだ登録されていません。</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
